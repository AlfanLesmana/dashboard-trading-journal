# Trading Dashboard Environment Variables
# Copy this file to .env and fill in the values
# DO NOT commit .env to GitHub (add to .gitignore)

# ============================================
# BACKEND CONFIGURATION
# ============================================

# Python runtime
PYTHONUNBUFFERED=1

# Database
DATABASE_URL=sqlite:///data/trades.db
# For PostgreSQL (future):
# DATABASE_URL=postgresql://user:password@localhost/trading_journal

# API Security
SECRET_KEY=your-secret-key-change-this-in-production-12345
DEBUG=false

# ============================================
# FRONTEND CONFIGURATION
# ============================================

# API base URL (frontend will call /api/...)
VITE_API_BASE=/api

# ============================================
# EXTERNAL API CACHING
# ============================================

# Forex Factory API rate limit: 2 req/5 min
# Cache duration in seconds (4 hours = 14400)
FOREX_FACTORY_CACHE_TTL=14400

# Yahoo Finance (yfinance) - daily OHLC data doesn't change intraday
# Cache duration in seconds (24 hours = 86400)
YFINANCE_CACHE_TTL=86400

# ============================================
# LOGGING & DEBUGGING
# ============================================

LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============================================
# OPTIONAL: MONITORING & METRICS
# ============================================

# If using Sentry for error tracking
# SENTRY_DSN=https://your-key@sentry.io/project-id

# If using Datadog or similar
# DATADOG_API_KEY=your-key

# ============================================
# NOTES
# ============================================

# 1. Change SECRET_KEY to a random string (at least 32 chars)
#    Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 2. For production, set DEBUG=false
#
# 3. DO NOT add sensitive keys to this file if it will be public
#    Use GitHub Secrets for CI/CD or VPS environment files
#
# 4. For HTTPS/SSL: configure at Nginx level, not here
#
# 5. Database file location (trades.db) is hardcoded in Python
#    Modify api/main.py if you need a different path
